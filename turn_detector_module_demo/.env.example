# TLS trust. Set these when the runtime CA differs from the Python environment default.
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# Local LiveKit server and browser connection.
LIVEKIT_URL=ws://127.0.0.1:8890
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_PUBLIC_URL=
LIVEKIT_AGENT_NAME=cascade-voice-agent

# Demo web server. Leave both certificate paths empty to use HTTP.
DEMO_ROOM=audio-turn-demo
DEMO_LANGUAGE=zh
DEMO_HOST=0.0.0.0
DEMO_PORT=8090
DEMO_HTTPS_IP=
DEMO_SSL_CERT_FILE=
DEMO_SSL_KEY_FILE=

# Python FunASR websocket client.
FUNASR_URL=ws://127.0.0.1:10095
FUNASR_MODE=2pass
FUNASR_LANGUAGE=zh
FUNASR_SAMPLE_RATE=16000
FUNASR_CHUNK_SIZE=8,8,4
FUNASR_CHUNK_INTERVAL=10
FUNASR_HOTWORDS=
FUNASR_INTERNAL_VAD=true
FUNASR_FINAL_WAIT_TIMEOUT=2.0

# FunASR C++/ONNX websocket client.
AGENT_STT_PROVIDER=funasr_cpp_onnx
FUNASR_CPP_URL=ws://127.0.0.1:10095
FUNASR_CPP_MODE=2pass
FUNASR_CPP_LANGUAGE=zh
FUNASR_CPP_SAMPLE_RATE=16000
FUNASR_CPP_CHUNK_SIZE=5,10,5
FUNASR_CPP_HOTWORDS=
FUNASR_CPP_WAV_NAME=livekit-agent
FUNASR_CPP_USE_ITN=true
FUNASR_CPP_FINAL_WAIT_TIMEOUT=2.0

# FunASR C++/ONNX source, build, dependency, and model paths.
FUNASR_CPP_ROOT=
FUNASR_CPP_UPSTREAM_DIR=
FUNASR_CPP_DEPS_DIR=
FUNASR_CPP_BUILD_DIR=
FUNASR_CPP_BIN=
FUNASR_CPP_ONNXRUNTIME_DIR=
FUNASR_CPP_ONNXRUNTIME_LIB_DIR=
FUNASR_CPP_ONNXRUNTIME_ARCHIVE=
FUNASR_CPP_FFMPEG_DIR=
FUNASR_CPP_FFMPEG_LIB_DIR=
FUNASR_CPP_FFMPEG_ARCHIVE=
FUNASR_CPP_DOWNLOAD_MODEL_DIR=
FUNASR_CPP_HOTWORD_FILE=

# FunASR C++/ONNX server and models.
FUNASR_CPP_HOST=127.0.0.1
FUNASR_CPP_PORT=10095
FUNASR_CPP_MODEL_DIR=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-onnx
FUNASR_CPP_ONLINE_MODEL_DIR=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online-onnx
FUNASR_CPP_VAD_DIR=damo/speech_fsmn_vad_zh-cn-16k-common-onnx
FUNASR_CPP_PUNC_DIR=damo/punc_ct-transformer_zh-cn-common-vad_realtime-vocab272727-onnx
FUNASR_CPP_ITN_DIR=thuduj12/fst_itn_zh
FUNASR_CPP_LM_DIR=
FUNASR_CPP_DECODER_THREAD_NUM=
FUNASR_CPP_MODEL_THREAD_NUM=1
FUNASR_CPP_IO_THREAD_NUM=

# FunASR dependency preparation.
FUNASR_CPP_REPO_URL=https://github.com/modelscope/FunASR.git
FUNASR_CPP_REPO_REF=main
FUNASR_CPP_ONNXRUNTIME_URL=https://isv-data.oss-cn-hangzhou.aliyuncs.com/ics/MaaS/ASR/dep_libs/onnxruntime-linux-x64-1.14.0.tgz
FUNASR_CPP_FFMPEG_URL=https://isv-data.oss-cn-hangzhou.aliyuncs.com/ics/MaaS/ASR/dep_libs/ffmpeg-master-latest-linux64-gpl-shared.tar.xz
FUNASR_CPP_BUILD_JOBS=

# Voice agent behavior.
AGENT_INSTRUCTIONS=
AGENT_GREETING=
AGENT_PREEMPTIVE_GENERATION=true
AGENT_PREEMPTIVE_MAX_RETRIES=3
AGENT_ENDPOINT_MIN_DELAY=0.3
AGENT_ENDPOINT_MAX_DELAY=2.5
AGENT_DEBUG_ENDPOINT_MAX_DELAY=10
AGENT_REQUIRE_EOU_POSITIVE=true
AGENT_FALSE_INTERRUPTION_TIMEOUT=1.0
AGENT_AEC_WARMUP_DURATION=3.0
AGENT_VAD_MIN_SPEECH_DURATION=0.05
AGENT_VAD_MIN_SILENCE_DURATION=0.25

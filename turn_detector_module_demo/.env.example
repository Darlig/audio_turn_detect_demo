# Local LiveKit server defaults. The helper script uses the same key/secret.
LIVEKIT_URL=ws://127.0.0.1:8890
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=false

# Browser-facing URL override, only needed for LAN/HTTPS cases.
LIVEKIT_PUBLIC_URL=

# Demo defaults.
DEMO_ROOM=audio-turn-demo
DEMO_LANGUAGE=zh
DEMO_HOST=0.0.0.0
DEMO_PORT=8090
DEMO_SSL_CERT_FILE=
DEMO_SSL_KEY_FILE=

# Local FunASR websocket service used by voice-agent.
FUNASR_URL=ws://127.0.0.1:10095
FUNASR_MODE=2pass
FUNASR_LANGUAGE=zh
FUNASR_SAMPLE_RATE=16000
FUNASR_CHUNK_SIZE=8,8,4
FUNASR_CHUNK_INTERVAL=10
FUNASR_HOTWORDS=
FUNASR_INTERNAL_VAD=true
FUNASR_FINAL_WAIT_TIMEOUT=2.0

# Voice agent behavior.
AGENT_INSTRUCTIONS=
AGENT_GREETING=
AGENT_PREEMPTIVE_GENERATION=true
AGENT_ENDPOINT_MIN_DELAY=0.3
AGENT_ENDPOINT_MAX_DELAY=2.5
AGENT_FALSE_INTERRUPTION_TIMEOUT=1.0
AGENT_AEC_WARMUP_DURATION=3.0
